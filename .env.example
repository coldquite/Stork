# .env is read by Nuxt CLI in dev/build/generate.
# When running a built server, provide env vars from the actual environment

# Based on https://auth.fit.cvut.cz/manager/app-types.xhtml
NUXT_FIT_AUTH_CLIENT_ID=your-fit-client-id
NUXT_FIT_AUTH_CLIENT_SECRET=your-fit-client-secret

NUXT_FIT_AUTH_ALLOWED_USERS=username1,username2
NUXT_AUTH_SESSION_SECRET=replace-with-long-random-secret
NUXT_AUTH_SESSION_ABSOLUTE_MAX_AGE_SECONDS=604800
NUXT_PUBLIC_I18N_BASE_URL=https://cap.ksi.in.fit.cvut.cz
NUXT_PUBLIC_FIT_AUTH_REDIRECT_URI=https://cap.ksi.in.fit.cvut.cz/api/auth/callback
