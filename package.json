{
  "name": "stork",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "build:with_licenses_check": "pnpm build && pnpm licenses:check",
    "dev": "nuxt dev",
    "start": "node --import ./.output/server/sentry.server.config.mjs .output/server/index.mjs",
    "preview": "nuxt preview",
    "postinstall": "pnpm db:generate && nuxt prepare",
    "licenses:check": "git diff --exit-code -- public/licenses.txt",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:unit": "vitest run test/server/unit",
    "test:integration": "vitest run test/server/request",
    "db:generate": "prisma generate",
    "db:format": "prisma format",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:reset": "prisma migrate reset",
    "db:migrations:check": "prisma migrate diff --from-migrations prisma/migrations --to-schema prisma/schema.prisma --exit-code",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm db:format"
  },
  "dependencies": {
    "@formkit/auto-animate": "^0.9.0",
    "@iconify-json/lucide": "^1.2.98",
    "@iconify-json/simple-icons": "^1.2.74",
    "@internationalized/date": "^3.12.0",
    "@nuxt/ui": "^4.5.1",
    "@pinia/nuxt": "0.11.3",
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "@sentry/nuxt": "^10",
    "@vueuse/integrations": "^14.2.1",
    "date-fns": "^4.1.0",
    "escape-html": "^1.0.3",
    "import-in-the-middle": "^3.0.0",
    "nuxt": "^4.4.2",
    "papaparse": "^5.5.3",
    "pg": "^8.20.0",
    "pinia": "^3.0.3",
    "pinia-plugin-persistedstate": "^4.7.1",
    "playwright": "^1.58.2",
    "sortablejs": "^1.15.7",
    "tailwindcss": "^4.2.1",
    "uuid": "^13.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@iconify-json/bi": "^1.2.7",
    "@nuxt/eslint": "^1.15.2",
    "@nuxt/test-utils": "^3.20.1",
    "@nuxtjs/i18n": "^10.2.3",
    "@playwright/test": "^1.58.2",
    "@types/escape-html": "^1.0.4",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.18.0",
    "@vitest/coverage-v8": "3.2.4",
    "@vue/test-utils": "^2.4.6",
    "dotenv": "^17.3.1",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^20.8.4",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.0",
    "prisma": "^7.5.0",
    "rollup-plugin-license": "^3.7.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.2.5"
  },
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "overrides": {
      "@vercel/nft": "^0.27.4",
      "reka-ui": "^2.9.3"
    }
  }
}
