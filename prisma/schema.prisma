// This is a Prisma schema file.
//
// The comments here briefly describe the mapping from the "studenti-CAP", "studenti-komise", and "komise" datasets exported from KOS IS

generator client {
  provider = "prisma-client"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
}

enum TimeScheduleType {
  MANUAL
  AUTO
}

enum CommitteeItemType {
  STUDENT
  PAUSE
}

enum PauseType {
  BREAK
  LUNCH
}

enum RepeatType {
  NONE
  THESIS_DEFENSE
  ORAL_EXAM
  BOTH
  UNKNOWN
}

enum ThesisLanguage {
  CZECH
  ENGLISH
  SLOVAK
}

enum StudyProgramType {
  BACHELOR
  MASTER
}

enum StudyLanguage {
  CZECH
  ENGLISH
}

model TimeSchedule {
  id        String           @id @default(cuid())
  name      String
  type      TimeScheduleType @default(MANUAL)
  createdAt DateTime         @default(now())

  committees Committee[]

  @@index([type, createdAt])
}

model Committee {
  id             String       @id @default(cuid())
  timeScheduleId String
  timeSchedule   TimeSchedule @relation(fields: [timeScheduleId], references: [id], onDelete: Cascade)

  name            String // studenti-komise: Komise - název (preprocess) + komise: Název komise (preprocess) ["242-BI, 5-BI-PI.21" => "5-BI-PI.21"]
  startMinute     Int           @default(525) // 8:45
  date            DateTime // komise: Datum
  room            String? // komise: Místo
  preparationRoom String? // Místnost písemné přípravy
  secretaryName   String? // komise: Správce
  invigilators    String[]      @default([])
  language        StudyLanguage // computed from "studenti-komise: St. program - kód" (endsWith "E" => ENGLISH, else CZECH)

  studyProgramName   String // studenti-komise: St. program - název + komise: Název studijního programu [e.g. Informatika]
  studyProgramType   StudyProgramType // studenti-komise: St. program - typ (computed => "B" => BACHELOR, "M" => MASTER)
  specializationName String // studenti-komise: Obor/spec - název + komise: Název oboru/specializace [e.g. Softwarové inženýrství 2021]
  specializationCode String // studenti-komise: Obor/spec - kód + komise: St. program (kód, název) [e.g. BI-SI21]

  chairName     String // studenti-komise: Komise - předseda (preprocess)
  viceChairName String // studenti-komise: Komise - místopředseda (preprocess)
  member1Name   String // studenti-komise: Komise - člen 1 (preprocess)
  member2Name   String // studenti-komise: Komise - člen 2 (preprocess)
  member3Name   String // studenti-komise: Komise - člen 3 (preprocess)

  items CommitteeItem[]

  @@unique([timeScheduleId, name])
}

model CommitteeItem {
  id          String    @id @default(cuid())
  committeeId String
  committee   Committee @relation(fields: [committeeId], references: [id], onDelete: Cascade)

  type     CommitteeItemType
  position Int

  student StudentItem?
  pause   PauseItem?

  @@unique([committeeId, position])
}

model StudentItem {
  itemId String        @id
  item   CommitteeItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  // Mapping studenti-CAP and studenti-komise using studenti-CAP:"Email studenta" and studenti-komise:"Email adresa".
  // They should be the same and, in fact, unique for each student (according to ICT CVUT).

  firstName                String // studenti-CAP: Jméno + studenti-komise: Jméno studenta
  lastName                 String // studenti-CAP: Příjmení + studenti-komise: Příjmení studenta
  email                    String? // studenti-CAP: Email studenta + studenti-komise: Email adresa
  titlesBefore             String? // studenti-CAP: Titul
  titlesAfter              String? // studenti-CAP: titul za
  thesisTitleLocal         String // studenti-CAP: VŠKP-typ A: Název práce + studenti-komise: VŠKP-typ A: Český název práce
  thesisTitleEn            String // studenti-CAP: VŠKP-typ A: Překlad názvu práce + studenti-komise: VŠKP-typ A: Anglický název práce
  thesisLanguage           ThesisLanguage // studenti-CAP: VŠKP-typ A: jazyk práce + studenti-komise: VŠKP-typ A: Jazyk práce
  supervisorName           String // studenti-CAP: VŠKP-typ A: Vedoucí práce 1 + studenti-komise: VŠKP-typ A: Vedoucí práce 1 (preprocess)
  reviewerName             String // studenti-CAP: VŠKP-typ A: Oponent práce 1 + studenti-komise: VŠKP-typ A: Oponent práce 1 (preprocess)
  additionalSupervisorName String? // studenti-komise: VŠKP-typ A: Vedoucí práce 2 (preprocess)
  additionalReviewerName   String? // studenti-komise: VŠKP-typ A: Oponent práce 2 (preprocess)

  studyProgramName   String // studenti-CAP: Studijní program (název) (Informatics)
  studyProgramType   StudyProgramType // computed from "studenti-CAP: Studijní program" (startwith "Bachelor"|"Bc." => BACHELOR, starts with "Mgr."|"Master" => MASTER)
  specializationName String // studenti-CAP: Obor/spec - název (Information Security 2021 (Bachelor in English))
  specializationCode String // studenti-CAP: Kód studijního plánu (BIE-IB.21)

  studyLanguage StudyLanguage // studenti-komise: Jazyk výuky

  repeatType RepeatType

  prepareMinutes Int
  examMinutes    Int
}

model PauseItem {
  itemId String        @id
  item   CommitteeItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  label           String
  durationMinutes Int
  pauseType       PauseType
}

model TeachersDictionary {
  id String @id @default(cuid())

  // Canonical display value, for example: "Ing. Marek Suchánek Ph.D. et Ph.D."
  canonicalName       String
  // Lookup key generated via token normalization and sorting for order-independent matching
  normalizedLookupKey String @unique

  // true for entries created manually in the app, false for imported records.
  isCustom  Boolean  @default(false)
  updatedAt DateTime @default(now()) @updatedAt

  @@index([isCustom])
}
